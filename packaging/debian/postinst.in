#!/bin/sh
set -eu

# Package installation may run outside a booted system (for example, while an
# image is assembled).  Reload and restart only on a running systemd host.
if [ "$1" = configure ] && test -d /run/systemd/system; then
    systemctl daemon-reload
    for unit in @PICDPLAYER_PACKAGE_START_ORDER@; do
        systemctl try-restart "$unit"
    done
fi
