get_property(PICDPLAYER_MULTI_CONFIG GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(PICDPLAYER_MULTI_CONFIG OR CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "PiCDPlayer requires a single-config generator; select CMAKE_BUILD_TYPE")
endif()
if("${CMAKE_BUILD_TYPE}" STREQUAL "")
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Application build type" FORCE)
endif()
set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS Debug Release RelWithDebInfo MinSizeRel)
if(NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "Unsupported CMAKE_BUILD_TYPE; use Debug, Release, RelWithDebInfo or MinSizeRel")
endif()
set(PICDPLAYER_PROFILE Release)
set(PICDPLAYER_DEBUG_DIAGNOSTICS 0)
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(PICDPLAYER_PROFILE Debug)
    set(PICDPLAYER_DEBUG_DIAGNOSTICS 1)
endif()
message(STATUS "PiCDPlayer application build_type=${CMAKE_BUILD_TYPE} profile=${PICDPLAYER_PROFILE}")
